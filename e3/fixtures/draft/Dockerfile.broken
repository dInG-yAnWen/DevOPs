# B14 E3 DRAFT failure candidate (intentionally broken).
# The python:3.13-slim base image ships no make and no C toolchain, so
# `RUN make` exits non-zero and `docker build` fails at this layer.
# Expected failure is locatable in the build log as: "make: not found".
FROM python:3.13-slim
WORKDIR /work
COPY main.c Makefile ./
RUN make
CMD ["./hello"]
