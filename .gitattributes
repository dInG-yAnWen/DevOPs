# Artifact SHA-256 values cover exact bytes. Do not convert line endings on
# checkout or git archive, regardless of the consumer's core.autocrlf setting.
/contracts/artifacts/** -text

# Evidence manifests hash original bytes, including any original mixed line endings.
/e3/evidence/** -text
/e4/evidence/** -text

# E5 model inputs, replies and raw evidence are hashed byte-for-byte.
/e5/evidence/** -text
/e5/model-records/** -text
/e5/candidates/** -text
/e5/scripts/*.py text eol=lf
/e5/tests/*.py text eol=lf

# E6 build evidence and saved candidate sources are hashed as exact bytes.
/e6/evidence/** -text
/e6/candidates/** -text
/e6/scripts/*.py text eol=lf
/services/draft/draft/*.py text eol=lf
/services/draft/tests/*.py text eol=lf

# Preserve the received A14 reply byte-for-byte for the handoff receipt hash.
/docs/collaboration/A14_回复B14_E3E4资料说明_20261008.md -text
