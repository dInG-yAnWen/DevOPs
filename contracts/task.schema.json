{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B14 / A14 E2 contract 1.0 (A14 accepted)",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Job"
    },
    {
      "$ref": "#/$defs/Accepted"
    },
    {
      "$ref": "#/$defs/ApiError"
    }
  ],
  "$defs": {
    "Repository": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https://[^\\s]+|ssh://[^\\s]+|git@[^\\s:]+:[^\\s]+)$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "url",
        "commit"
      ],
      "additionalProperties": false
    },
    "Build": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "verify_command": {
          "type": "string",
          "minLength": 1
        },
        "working_directory": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:).+$"
        }
      },
      "required": [
        "command",
        "verify_command",
        "working_directory"
      ],
      "additionalProperties": false
    },
    "Execution": {
      "type": "object",
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 1800
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        }
      },
      "required": [
        "timeout_seconds"
      ],
      "additionalProperties": false
    },
    "EnvironmentRequirements": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "base_image": {
          "type": "string",
          "minLength": 1
        },
        "system_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "network": {
          "enum": [
            "REQUIRED",
            "OPTIONAL",
            "DISABLED"
          ]
        },
        "environment_variables": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "minItems": 0
        },
        "test_data": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:).+$"
          },
          "minItems": 0
        }
      },
      "required": [
        "platform",
        "language",
        "toolchain",
        "base_image",
        "system_dependencies",
        "network",
        "environment_variables",
        "ports",
        "test_data"
      ],
      "additionalProperties": false
    },
    "Environment": {
      "type": "object",
      "properties": {
        "image_ref": {
          "type": "string",
          "pattern": "^.+@sha256:[0-9a-f]{64}$"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "dockerfile_uri": {
          "type": "string",
          "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
        },
        "producer_job_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "image_ref",
        "configuration_id",
        "dockerfile_uri",
        "producer_job_id"
      ],
      "additionalProperties": false
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "DOCKERFILE",
            "IMAGE_METADATA",
            "BUILD_LOG",
            "VERIFY_LOG",
            "ITERATION_PATCH",
            "ACTUAL_GRAPH",
            "DECLARED_GRAPH",
            "ERROR_REPORT",
            "PATCH",
            "RECHECK_REPORT"
          ]
        },
        "uri": {
          "type": "string",
          "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "producer_job_id": {
          "type": "string",
          "minLength": 1
        },
        "repository_url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "type",
        "uri",
        "media_type",
        "producer_job_id",
        "repository_url",
        "commit",
        "configuration_id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "INPUT_1001",
            "INPUT_1002",
            "INPUT_1003",
            "INPUT_1004",
            "INPUT_1005",
            "INPUT_1006",
            "JOB_2001",
            "ENV_3002",
            "EXEC_4001",
            "EXEC_4002",
            "EXEC_4003",
            "EXEC_4004",
            "ANALYSIS_5001",
            "REPAIR_6001"
          ]
        },
        "category": {
          "enum": [
            "INPUT",
            "GOAL_UNMET",
            "SYSTEM",
            "CONTROL"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "category",
        "message",
        "retryable",
        "details"
      ],
      "additionalProperties": false
    },
    "CommandResult": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "PASSED",
            "FAILED",
            "NOT_RUN"
          ]
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "log_uri": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "exit_code",
        "log_uri"
      ],
      "additionalProperties": false
    },
    "Iteration": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "change_summary": {
          "type": "string",
          "minLength": 1
        },
        "selection_reason": {
          "type": "string",
          "minLength": 1
        },
        "patch_uri": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "build": {
          "$ref": "#/$defs/CommandResult"
        },
        "verify": {
          "$ref": "#/$defs/CommandResult"
        }
      },
      "required": [
        "index",
        "change_summary",
        "selection_reason",
        "patch_uri",
        "build",
        "verify"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "MISSING",
            "REDUNDANT"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "dependency": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:).+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "detector": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:).+$"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "path",
            "line"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "DYNAMIC_TRACE",
                "STATIC_INFERENCE",
                "MANUAL_FIXTURE",
                "INSTRUCTOR_ORACLE"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "description"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "finding_id",
        "type",
        "target",
        "dependency",
        "commit",
        "detector",
        "location",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Report": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "repository": {
          "$ref": "#/$defs/Repository"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "producer_job_id": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "repository",
        "configuration_id",
        "producer_job_id",
        "findings"
      ],
      "additionalProperties": false
    },
    "Graph": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "repository": {
          "$ref": "#/$defs/Repository"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "producer_job_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ACTUAL_GRAPH",
            "DECLARED_GRAPH"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "dependency": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "target",
              "dependency"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "source": {
          "const": "MANUAL_FIXTURE"
        }
      },
      "required": [
        "schema_version",
        "repository",
        "configuration_id",
        "producer_job_id",
        "kind",
        "nodes",
        "edges",
        "source"
      ],
      "additionalProperties": false
    },
    "ImageMetadata": {
      "type": "object",
      "properties": {
        "image_ref": {
          "type": "string",
          "pattern": "^.+@sha256:[0-9a-f]{64}$"
        },
        "repository": {
          "$ref": "#/$defs/Repository"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "producer_job_id": {
          "type": "string",
          "minLength": 1
        },
        "available": {
          "type": "boolean"
        },
        "source": {
          "const": "MANUAL_FIXTURE"
        }
      },
      "required": [
        "image_ref",
        "repository",
        "configuration_id",
        "producer_job_id",
        "available",
        "source"
      ],
      "additionalProperties": false
    },
    "RecheckReport": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "#/$defs/Repository"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "producer_job_id": {
          "type": "string",
          "minLength": 1
        },
        "patch_uri": {
          "type": "string",
          "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
        },
        "remaining_missing": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "const": "MANUAL_FIXTURE"
        }
      },
      "required": [
        "repository",
        "configuration_id",
        "producer_job_id",
        "patch_uri",
        "remaining_missing",
        "source"
      ],
      "additionalProperties": false
    },
    "DraftInput": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "#/$defs/Repository"
        },
        "build": {
          "$ref": "#/$defs/Build"
        },
        "requirements": {
          "$ref": "#/$defs/EnvironmentRequirements"
        }
      },
      "required": [
        "repository",
        "build",
        "requirements"
      ],
      "additionalProperties": false
    },
    "FullInput": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "#/$defs/Repository"
        },
        "build": {
          "$ref": "#/$defs/Build"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        }
      },
      "required": [
        "repository",
        "build",
        "environment"
      ],
      "additionalProperties": false
    },
    "IncrementalInput": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "#/$defs/Repository"
        },
        "build": {
          "$ref": "#/$defs/Build"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "baseline": {
          "type": "object",
          "properties": {
            "repository_url": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "configuration_id": {
              "type": "string",
              "minLength": 1
            },
            "actual_graph_uri": {
              "type": "string",
              "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
            },
            "error_report_uri": {
              "type": "string",
              "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
            }
          },
          "required": [
            "repository_url",
            "commit",
            "configuration_id",
            "actual_graph_uri",
            "error_report_uri"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "repository",
        "build",
        "environment",
        "base_commit",
        "baseline"
      ],
      "additionalProperties": false
    },
    "RepairInput": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "#/$defs/Repository"
        },
        "build": {
          "$ref": "#/$defs/Build"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "md_report_uri": {
          "type": "string",
          "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
        },
        "makefiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:).+$"
          },
          "minItems": 1
        }
      },
      "required": [
        "repository",
        "build",
        "environment",
        "md_report_uri",
        "makefiles"
      ],
      "additionalProperties": false
    },
    "DraftOutput": {
      "type": "object",
      "properties": {
        "environment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Environment"
            },
            {
              "type": "null"
            }
          ]
        },
        "iterations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Iteration"
          },
          "minItems": 0
        },
        "build": {
          "$ref": "#/$defs/CommandResult"
        },
        "verify": {
          "$ref": "#/$defs/CommandResult"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "minItems": 0
        }
      },
      "required": [
        "environment",
        "iterations",
        "build",
        "verify",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "FullOutput": {
      "type": "object",
      "properties": {
        "actual_graph_uri": {
          "type": "string",
          "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
        },
        "declared_graph_uri": {
          "type": "string",
          "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
        },
        "error_report_uri": {
          "type": "string",
          "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "minItems": 3
        }
      },
      "required": [
        "actual_graph_uri",
        "declared_graph_uri",
        "error_report_uri",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "IncrementalOutput": {
      "type": "object",
      "properties": {
        "actual_graph_uri": {
          "type": "string",
          "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
        },
        "declared_graph_uri": {
          "type": "string",
          "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
        },
        "error_report_uri": {
          "type": "string",
          "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
        },
        "findings_delta": {
          "type": "object",
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            }
          },
          "required": [
            "added",
            "removed"
          ],
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "minItems": 3
        }
      },
      "required": [
        "actual_graph_uri",
        "declared_graph_uri",
        "error_report_uri",
        "findings_delta",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "Candidate": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "patch_uri": {
          "type": "string",
          "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
        },
        "declaration_style": {
          "enum": [
            "ATOMIC",
            "MACRO",
            "HYBRID"
          ]
        },
        "style_explanation": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "ACCEPTED",
            "REJECTED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "$ref": "#/$defs/CommandResult"
        },
        "verify": {
          "$ref": "#/$defs/CommandResult"
        },
        "recheck": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "PASSED",
                "FAILED",
                "NOT_RUN"
              ]
            },
            "remaining_missing": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "report_uri": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "remaining_missing",
            "report_uri"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "candidate_id",
        "patch_uri",
        "declaration_style",
        "style_explanation",
        "decision",
        "reason",
        "build",
        "verify",
        "recheck"
      ],
      "additionalProperties": false
    },
    "RepairOutput": {
      "type": "object",
      "properties": {
        "patch_uri": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "minItems": 0
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "minItems": 0
        }
      },
      "required": [
        "patch_uri",
        "candidates",
